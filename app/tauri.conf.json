{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tomcatrun",
  "identifier": "io.github.a7garden.tomcatrun",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tomcatrun",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing --renderer-process-limit=1 --disable-background-networking"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
