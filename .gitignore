# 소스 · 설정 원본 · 문서만 둔다. 내려받거나 다시 만드는 것, 그 PC 의 설정은 넣지 않는다.

# 빌드 결과
/app/target/
/installer/dist/
/installer/stage/
/*.exe
*.class

# 내려받은 실행 환경 (installer/fetch.sh · DCEVM JDK · HotswapAgent · Maven · 빌드용 jar)
/bin/

# 이 PC 의 설정 — 프로젝트 경로 · 사내 주소가 들어간다
/tomcatrun.json
*.json.bak

# 서버마다 실행기가 만드는 것 (의존 jar · 컴파일 결과 · 톰캣 실행 흔적 · 더한 서버)
/deps/
/classes/
/servers/
/out/
/base/log/
/base/logs/
/base/temp/
/base/work/
/base/webapps/
/base/maven/
/base/conf/web-dev.xml
/base/conf/Catalina/

# 디자인 도구의 작업 상태 (화면 캡처 · 시안에 그 PC 의 데이터가 들어간다)
/.impeccable/

# 상주 컴파일러 데우기 임시 파일
/helper/warm/
