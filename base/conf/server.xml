<?xml version="1.0" encoding="UTF-8"?>
<!--
  tomcatrun 로컬 개발 톰캣 — 모든 서버가 이 한 벌을 함께 쓴다.

  프로젝트 경로 · 포트 · 폴더는 여기 적지 않는다. 실행기가 기동할 때 설정(tomcatrun.json · 「설정 › 서버」)에서 읽어
  시스템 속성(tomcatrun.*)으로 넘기고, 톰캣이 ${...} 를 그 값으로 바꾼다.
  다른 서버의 CATALINA_BASE 에 conf 가 없으면 실행기가 이 폴더를 복사해 쓴다.

  · 배포 사본이 없다. 소스 폴더를 그대로 읽는다.
      화면 파일          <프로젝트>/src/main/webapp                 (tomcatrun.webapp)
      설정 · 매퍼 XML    <프로젝트>/src/main/resources → /WEB-INF/classes (tomcatrun.resources)
      컴파일한 클래스    서버의 classes 폴더          → /WEB-INF/classes (tomcatrun.classes)
      개발 전용 앱 설정  <실행기 폴더>/overlay         → /WEB-INF/classes (tomcatrun.overlay)
      의존 jar           서버의 deps 폴더             → /WEB-INF/lib     (tomcatrun.deps)
  · 앱은 하나만 올린다. 접속 경로는 서버 설정의 값이다 (tomcatrun.contextPath · 비면 "/").
  · maxParameterCount 도 서버 설정의 값이다 (tomcatrun.maxParameterCount · 기본 10000 = 톰캣 8.5 기본 · 이클립스 서버에 값이 없을 때와 같다).
  · reloadable="false" — 클래스 반영은 HotswapAgent 가 한다. 켜 두면 클래스 하나에 앱 전체가 다시 뜬다.
-->
<Server port="${tomcatrun.shutdownPort}" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener"/>
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener"/>

  <Service name="Catalina">
    <Connector port="${tomcatrun.httpPort}" protocol="HTTP/1.1" connectionTimeout="20000" maxParameterCount="${tomcatrun.maxParameterCount}" redirectPort="8443"/>
    <!-- 같은 PC 의 앞단(Apache mod_jk 등)용이다. 비밀값 없이 여는 대신 127.0.0.1 에만 묶어 밖에서 닿지 않게 한다 -->
    <Connector port="${tomcatrun.ajpPort}" protocol="AJP/1.3" address="127.0.0.1" redirectPort="8443" secretRequired="false"/>

    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" autoDeploy="false" deployOnStartup="false" unpackWARs="false">
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="localhost_access_log" suffix=".txt" pattern="%h %l %u %t &quot;%r&quot; %s %b"/>

        <!-- 클래스 전체 탐색 건너뛰기 (「설정 › 기동」)
             · altDDName : 실행기가 기동마다 원본 web.xml 의 사본(conf/web-dev.xml)을 만든다. 옵션을 켜면 사본에
                           metadata-complete="true" 와 빈 <absolute-ordering/> 만 더하고, 끄면 원본과 같다.
             · containerSciFilter : 옵션을 켜면 톰캣 쪽 웹소켓 초기화 클래스(WsSci)도 거른다. 끄면 빈 값이라 거르지 않는다. -->
        <Context path="${tomcatrun.contextPath}" docBase="${tomcatrun.webapp}" reloadable="false"
                 altDDName="${catalina.base}/conf/web-dev.xml" containerSciFilter="${tomcatrun.sciFilter}">
          <!-- cacheTtl 1초 : 정적 파일을 고친 뒤 톰캣이 옛 내용을 들고 있는 시간 (기본 5초) -->
          <Resources cachingAllowed="true" cacheTtl="1000" cacheMaxSize="102400">
            <!-- 원본 resources 가 먼저다. 컴파일 폴더에는 클래스만 있다. -->
            <PreResources className="org.apache.catalina.webresources.DirResourceSet"
                          base="${tomcatrun.resources}" webAppMount="/WEB-INF/classes"/>
            <PreResources className="org.apache.catalina.webresources.DirResourceSet"
                          base="${tomcatrun.classes}" webAppMount="/WEB-INF/classes"/>
            <!-- 개발 전용 앱 설정 (tomcatrun.DevTweaks) · spring/context-zz-tomcatrun.xml 은 이름이 달라 원본을 가리지 않고,
                 egovframework/springmvc/application-servlet.xml 은 경로가 같지만 위에 물린 원본이 먼저 찾힌다 -->
            <PreResources className="org.apache.catalina.webresources.DirResourceSet"
                          base="${tomcatrun.overlay}" webAppMount="/WEB-INF/classes"/>
            <!-- src/main/webapp/WEB-INF/lib 의 jar 는 docBase 로 이미 들어온다. 이름이 같으면 그쪽이 이긴다. -->
            <PostResources className="org.apache.catalina.webresources.DirResourceSet"
                           base="${tomcatrun.deps}" webAppMount="/WEB-INF/lib"/>
          </Resources>
          <!-- jar 스캔 (「설정 › 서버」의 TLD jar)
               비워 두면 톰캣 기본대로 모든 jar 에서 TLD 를 찾는다 (catalina.properties 의 tldSkip 은 뺀다).
               적으면 그 jar 만 본다 — 기동이 빨라지지만, 빠뜨린 태그 라이브러리를 쓰는 JSP 는 「태그를 찾을 수 없다」로 깨진다.
               web-fragment · 초기화 클래스(pluggability)는 클래스 전체 탐색 건너뛰기를 켜면 보지 않는다. -->
          <JarScanner scanClassPath="false">
            <JarScanFilter defaultTldScan="${tomcatrun.tldScanAll}" tldScan="${tomcatrun.tldScan}"
                           defaultPluggabilityScan="${tomcatrun.pluggabilityScan}" pluggabilityScan=""/>
          </JarScanner>
        </Context>
      </Host>
    </Engine>
  </Service>
</Server>
